{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AntTheLimey/gm-apprentice/blob/main/tools/publish/schema/vault-config.schema.json",
  "title": "gm-apprentice vault settings",
  "description": "The settings of a campaign vault, as written in _meta/vault-config.yaml. Generated from the tool's list of settings; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "The layout's number",
      "const": 1
    },
    "vault": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kept_by": {
          "description": "Who keeps this vault: `gm` for the game master, `player` for a player keeping notes on a campaign they are in",
          "default": "gm",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\s*(?:[gG][mM]|[pP][lL][aA][yY][eE][rR])\\s*$"
        },
        "campaign": {
          "description": "The campaign's name",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "attachments": {
          "description": "The vault folder that holds pictures",
          "default": "_attachments",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "system": {
          "description": "The game system, which decides how a character sheet is drawn",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\s*(?:[cC][oO][cC]\\-7[eE]|[cC][oO][cC]|[rR][eE][gG][eE][nN][cC][yY]\\-[cC][tT][hH][uU][lL][hH][uU]|[cC][oO][cC]\\-7[eE]\\-[rR][eE][gG][eE][nN][cC][yY]|[gG][uU][rR][pP][sS]\\-4[eE]|[gG][uU][rR][pP][sS]|[dD][nN][dD]\\-5[eE]|[dD][nN][dD]\\-5[eE]\\-2024|[dD][nN][dD]|[fF][iI][tT][dD]|[bB][lL][aA][dD][eE][sS]|[pP][fF]2[eE]|[pP][aA][tT][hH][fF][iI][nN][dD][eE][rR]\\-2[eE]|[pP][aA][tT][hH][fF][iI][nN][dD][eE][rR])\\s*$"
        },
        "setting_year": {
          "description": "An in-game year, shown on the landing page when the campaign overview gives no current date, and on a Call of Cthulhu sheet beside its era.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "dndbeyond_sync": {
          "description": "When D&D characters that carry a D&D Beyond link are brought up to date: `build` before each site update, or `manual` only when you ask",
          "default": "manual",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\s*(?:[bB][uU][iI][lL][dD]|[mM][aA][nN][uU][aA][lL])\\s*$"
        }
      },
      "additionalProperties": false
    },
    "player_site": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "publish": {
          "description": "Whether this vault has a site",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
            }
          ]
        },
        "folder": {
          "description": "The folder on this computer that holds the site",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "title": {
          "description": "The name in the menu bar and the browser tab",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "footer": {
          "description": "A line at the foot of every page",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "features": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "search": {
              "description": "The search box",
              "default": true,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "link_previews": {
              "description": "The small card that opens when a reader rests on a link to another page, or taps it once on a phone. `on` shows it everywhere; `desktop` keeps it to a mouse and keyboard, so on a phone a tap goes straight to the page",
              "default": "on",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[oO][nN]|[dD][eE][sS][kK][tT][oO][pP]|[oO][fF][fF]|[tT][rR][uU][eE]|[yY][eE][sS]|[fF][aA][lL][sS][eE]|[nN][oO])\\s*$"
                },
                {
                  "const": true
                },
                {
                  "const": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "connections": {
              "description": "How the Connections section on a page is drawn: what the page's subject is tied to, in tabs by kind (people, places, organisations and so on), with pages that only mention it in a last tab. `tree` is a branching list, readable on a phone; `web` puts the subject in the middle with names around it; `cards` gives a card for each; `off` leaves out the section and the list of mentions. `on`, `yes` and `true` read as `tree`; `no` and `false` as `off`",
              "default": "tree",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][eE][eE]|[wW][eE][bB]|[cC][aA][rR][dD][sS]|[oO][fF][fF]|[tT][rR][uU][eE]|[oO][nN]|[yY][eE][sS]|[fF][aA][lL][sS][eE]|[nN][oO])\\s*$"
                },
                {
                  "const": true
                },
                {
                  "const": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "tohit_calculator": {
              "description": "The to-hit calculator on a GURPS character's Combat tab",
              "default": "on",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[oO][nN]|[oO][fF][fF]|[tT][rR][uU][eE]|[yY][eE][sS]|[fF][aA][lL][sS][eE]|[nN][oO])\\s*$"
                },
                {
                  "const": true
                },
                {
                  "const": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "live_stats": {
              "description": "Players change hit points, spent resources and conditions on their own sheet during a session, and the party board follows. For Call of Cthulhu, GURPS and D&D; it does nothing for Pathfinder or Forged in the Dark",
              "default": false,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                }
              ]
            },
            "inbox": {
              "description": "A box on each character page for sending the GM a request or a question",
              "default": false,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                }
              ]
            }
          }
        },
        "not_found": {
          "description": "The words a reader sees after following a link to a page that is not there",
          "default": "This page is not available.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "url": {
          "description": "The site's public address. A site that lives in a sub-folder of its host, such as a project page on GitHub, takes its base path from this",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "host": {
          "description": "Where the site is hosted: `github-pages` or `cloudflare-pages`. Any other word is reported, and `github-pages` is used",
          "default": "github-pages",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\s*(?:[gG][iI][tT][hH][uU][bB]\\-[pP][aA][gG][eE][sS]|[cC][lL][oO][uU][dD][fF][lL][aA][rR][eE]\\-[pP][aA][gG][eE][sS])\\s*$"
        },
        "output": {
          "description": "The folder the finished pages are written to, inside the site folder. Each build empties it first (except what `player_site.keep` names), so it can be neither the site folder itself nor a folder outside it; a setting that breaks this stops the build",
          "default": "docs",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "cloudflare_project": {
          "description": "The site's project name on Cloudflare, when it differs from the site folder's name",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "keep": {
          "description": "Folders inside the output folder that a rebuild must leave alone, each a plain folder name (no slashes). A setting that breaks this stops the build",
          "default": [],
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "before_build": {
          "description": "Commands the publish tool runs, in order, in the site folder, before it builds. A command that fails stops the build and nothing is published",
          "default": [],
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "after_build": {
          "description": "Commands the publish tool runs, in order, in the site folder, after every page is written (image tidying, extra pages). A command that fails stops the build and nothing is published",
          "default": [],
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "menu_extra": {
          "description": "Extra entries in the site's menu. `link` is the name of a page, a web address (`https://…`), or an address on the site (`gazetteer/index.html`). `group` puts the entry under one of the menu's groups (`Story`, `Characters`, `World`, `Reference`) or makes a new one; with none it stands on its own after the groups. A link to a note that has no page is left out, with a warning",
          "default": [],
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "link": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "group": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "required": [
              "label",
              "link"
            ],
            "additionalProperties": false
          }
        },
        "hide": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "mode": {
              "description": "`player` leaves out any note still marked as prep (a planned session, a draft or outline, a scene that was cut) and, when the vault has a publish list, publishes only the notes on it. `full` publishes those too, for a private copy of your own",
              "default": "player",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\s*(?:[pP][lL][aA][yY][eE][rR]|[fF][uU][lL][lL])\\s*$"
            },
            "folders": {
              "description": "Vault folders never published",
              "default": [
                "_meta",
                "_Templates"
              ],
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "sections": {
              "description": "Headings whose text is never published, on any page, however the heading is dressed (bold, a colon, a link)",
              "default": [
                "GM Notes",
                "DM Notes",
                "Player Notes",
                "Source References",
                "Reconciliation Context",
                "Handoff to Reconcile"
              ],
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "fields": {
              "description": "Fields in the block at the top of a note (between its `---` lines) that are never shown",
              "default": [
                "secrets",
                "current_plan",
                "plan_progress",
                "gm_notes",
                "prep_notes",
                "reliability"
              ],
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "callouts": {
              "description": "Whether Obsidian callouts (`> [!note]`) are left out",
              "default": false,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "drafts": {
              "description": "Whether a note with `canon_status: DRAFT` at its top is left off the site",
              "default": false,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "field_exceptions": {
              "description": "Lets one note show a field that `player_site.hide.fields` hides everywhere else",
              "default": {},
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "folder_map": {
          "description": "Which vault folders are published, and the web address each gets",
          "default": {},
          "type": [
            "object",
            "null"
          ]
        },
        "theme": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "genre": {
              "description": "A ready-made look: colours, lettering and section names. A genre the tool does not know is reported, and the site keeps the plain dark look",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\s*(?:[hH][oO][rR][rR][oO][rR]|[fF][aA][nN][tT][aA][sS][yY]|[nN][oO][iI][rR]|[mM][iI][lL][iI][tT][aA][rR][yY]|[sS][cC][iI][fF][iI]|[gG][oO][tT][hH][iI][cC]|[cC][tT][hH][uU][lL][hH][uU]|[aA][dD][vV][eE][nN][tT][uU][rR][eE]|[iI][nN][dD][uU][sS][tT][rR][iI][aA][lL]|[hH][eE][iI][sS][tT]|[tT][aA][cC][tT][iI][cC][aA][lL]|[mM][oO][dD][eE][rR][nN]|[sS][cC][iI]\\-[fF][iI]|[sS][cC][iI][eE][nN][cC][eE]\\-[fF][iI][cC][tT][iI][oO][nN]|[sS][pP][aA][cC][eE]|[sS][pP][aA][cC][eE]\\-[oO][pP][eE][rR][aA]|[sS][pP][aA][cC][eE]\\-[nN][oO][iI][rR])\\s*$"
            },
            "palette": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "primary": {
                  "description": "The main colour of your own palette. The four colours are set together: set all four, or none. Setting any one replaces the genre's colours, and a colour you leave out takes the built-in one",
                  "default": "#1a2f3a",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "accent": {
                  "description": "The accent colour of your own palette. The four colours are set together: set all four, or none. Setting any one replaces the genre's colours, and a colour you leave out takes the built-in one",
                  "default": "#3d8a7a",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "background": {
                  "description": "The page background colour of your own palette. The four colours are set together: set all four, or none. Setting any one replaces the genre's colours, and a colour you leave out takes the built-in one",
                  "default": "#e8f0f3",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "text": {
                  "description": "The text colour of your own palette. The four colours are set together: set all four, or none. Setting any one replaces the genre's colours, and a colour you leave out takes the built-in one",
                  "default": "#1a1a1a",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            },
            "fonts": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "heading": {
                  "description": "The lettering for headings",
                  "default": "system-ui",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "body": {
                  "description": "The lettering for body text",
                  "default": "system-ui",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "source": {
                  "description": "Where the lettering comes from: `self-host` (the site downloads the typefaces once and serves them itself), `google` (the reader's browser fetches them from Google Fonts) or `local` (your own font files). With `self-host` a reader's browser never contacts Google. A source the tool does not know is reported, and `google` is used",
                  "default": "google",
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\s*(?:[gG][oO][oO][gG][lL][eE]|[sS][eE][lL][fF]\\-[hH][oO][sS][tT]|[lL][oO][cC][aA][lL])\\s*$"
                },
                "files": {
                  "description": "Your own font files, each listed with its `family` (the typeface's name) and `path` (the file's place in the vault); used when the source is `local`",
                  "default": []
                }
              }
            },
            "campaign_image": {
              "description": "The large picture at the top of the landing page",
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "default_mode": {
              "description": "Whether a reader starts in light or dark",
              "default": "system",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\s*(?:[sS][yY][sS][tT][eE][mM]|[dD][aA][rR][kK]|[lL][iI][gG][hH][tT])\\s*$"
            },
            "tagline": {
              "description": "One sentence under the title on the landing page",
              "type": [
                "string",
                "number",
                "null"
              ]
            }
          }
        },
        "lists": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "section_titles": {
              "description": "Your own headings for the lists of locations, factions, items, creatures and documents",
              "default": {},
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "locations": {},
                "factions": {},
                "items": {},
                "creatures": {},
                "documents": {}
              }
            },
            "banners": {
              "description": "A picture or map at the top of a section's list",
              "default": {},
              "type": [
                "object",
                "null"
              ]
            },
            "locations": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "group_by": {
                  "description": "Splits the list of locations into one block, under its own heading, for each place of a kind, such as each star system"
                },
                "ungrouped_label": {
                  "description": "The heading for places that fall in no block",
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "show": {
              "description": "Whether a character's page carries its sheet",
              "default": true,
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(?:[tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF])\\s*$"
                }
              ]
            },
            "prose_sections": {
              "description": "With sheets off, extra sections of a character's note that are still published",
              "default": [],
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "skin": {
              "description": "The look of every character sheet",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\s*(?:[pP][lL][aA][iI][nN]|[pP][aA][rR][cC][hH][mM][eE][nN][tT]|[cC][aA][sS][eE]\\-[fF][iI][lL][eE]|[cC][oO][nN][sS][oO][lL][eE]|[lL][eE][dD][gG][eE][rR])\\s*$"
            },
            "frame": {
              "description": "The ornament round each portrait",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\s*(?:[nN][oO][nN][eE]|[rR][iI][nN][gG]|[lL][aA][uU][rR][eE][lL]|[tT][hH][oO][rR][nN][sS]|[gG][iI][lL][tT]|[sS][tT][eE][eE][lL]|[cC][oO][rR][nN][eE][rR][sS]|[hH][eE][xX]|[cC][rR][aA][cC][kK][eE][dD])\\s*$"
            },
            "crest": {
              "description": "A crest or wax seal at the head of a Call of Cthulhu sheet",
              "type": [
                "string",
                "number",
