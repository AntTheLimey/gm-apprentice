[
  { "name": "site title from the vault file only", "vault": { "site_title": "Canticle" }, "site": {}, "expect": { "site_title": "Canticle" }, "legacy": [] },
  { "name": "site title from the site file only is used and reported", "vault": {}, "site": { "siteTitle": "Old" }, "expect": { "site_title": "Old" }, "legacy": [{ "key": "siteTitle", "status": "used" }] },
  { "name": "vault file wins and the site file is reported ignored", "vault": { "site_title": "New" }, "site": { "siteTitle": "Old" }, "expect": { "site_title": "New" }, "legacy": [{ "key": "siteTitle", "status": "ignored" }] },
  { "name": "search defaults on", "vault": {}, "site": {}, "expect": { "search": true }, "legacy": [] },
  { "name": "search false in the site file is honoured", "vault": {}, "site": { "searchEnabled": false }, "expect": { "search": false }, "legacy": [{ "key": "searchEnabled", "status": "used" }] },
  { "name": "exclude_dirs: site-only entries still apply until migrated", "vault": { "exclude_dirs": ["Drafts"] }, "site": { "excludeDirs": ["Secrets", "drafts"] }, "expect": { "exclude_dirs": ["Drafts", "Secrets"] }, "legacy": [{ "key": "excludeDirs", "status": "ignored", "stillApplied": ["Secrets"] }] },
  { "name": "exclude_dirs from the site file alone still applies", "vault": {}, "site": { "excludeDirs": ["Secrets"] }, "expect": { "exclude_dirs": ["Secrets"] }, "legacy": [{ "key": "excludeDirs", "status": "used" }] },
  { "name": "exclude_sections default when neither sets it", "vault": {}, "site": {}, "expect": { "exclude_sections": ["GM Notes", "DM Notes", "Player Notes", "Source References", "Reconciliation Context", "Handoff to Reconcile"] }, "legacy": [] },
  { "name": "exclude_sections: site-only entries still apply until migrated", "vault": { "exclude_sections": ["GM Notes"] }, "site": { "excludeSections": ["GM Notes", "Keeper Only"] }, "expect": { "exclude_sections": ["GM Notes", "Keeper Only"] }, "legacy": [{ "key": "excludeSections", "status": "ignored", "stillApplied": ["Keeper Only"] }] },
  { "name": "folder_map from the vault file", "vault": { "folder_map": { "NPCs": "npcs" } }, "site": { "folderMap": { "Old": "old" } }, "expect": { "folder_map": { "NPCs": "npcs" } }, "legacy": [{ "key": "folderMap", "status": "ignored" }] },
  { "name": "system falls back to the site file", "vault": {}, "site": { "system": "gurps-4e" }, "expect": { "system": "gurps-4e" }, "legacy": [{ "key": "system", "status": "used" }] },
  { "name": "an explicit false is a value, not silence", "vault": { "exclude_callouts": false }, "site": { "excludeCallouts": true }, "expect": { "exclude_callouts": false }, "legacy": [{ "key": "excludeCallouts", "status": "ignored" }] },
  {"name": "exclude_dirs entries are compared after normalising (trailing slash is the same entry)", "vault": {"exclude_dirs": ["Secrets"]}, "site": {"excludeDirs": ["Secrets/"]}, "expect": {"exclude_dirs": ["Secrets"]}, "legacy": [{"key": "excludeDirs", "status": "ignored"}]},
  {"name": "a vault list key that is empty falls to the default and the site entries are added to it", "vault": {"exclude_sections": null}, "site": {"excludeSections": ["Keeper Only", "GM Notes"]}, "expect": {"exclude_sections": ["GM Notes", "DM Notes", "Player Notes", "Source References", "Reconciliation Context", "Handoff to Reconcile", "Keeper Only"]}, "legacy": [{"key": "excludeSections", "status": "ignored", "stillApplied": ["Keeper Only"]}], "warns": "publish.exclude_sections"},
  {"name": "a vault list key that is a scalar falls to the default", "vault": {"exclude_dirs": "Secrets"}, "site": {}, "expect": {"exclude_dirs": ["_meta", "_Templates"]}, "legacy": [], "warns": "publish.exclude_dirs"},
  {"name": "search accepts the switch words (off)", "vault": {"search": "off"}, "site": {}, "expect": {"search": false}, "legacy": []},
  {"name": "search accepts the switch words (no, in the site file)", "vault": {}, "site": {"searchEnabled": "No"}, "expect": {"search": false}, "legacy": [{"key": "searchEnabled", "status": "used"}]},
  {"name": "search yes is on", "vault": {"search": "yes"}, "site": {}, "expect": {"search": true}, "legacy": []},
  {"name": "search that is not a switch word stays on, with a warning naming the key", "vault": {"search": "maybe"}, "site": {}, "expect": {"search": true}, "legacy": [], "warns": "publish.search"},
  {"name": "exclude_callouts as a list of types: the vault file's list wins over the site file's true", "vault": {"exclude_callouts": ["gm", "secret"]}, "site": {"excludeCallouts": true}, "expect": {"exclude_callouts": ["gm", "secret"]}, "legacy": [{"key": "excludeCallouts", "status": "ignored"}]},
  {"name": "exclude_callouts as a list of types from the site file alone", "vault": {}, "site": {"excludeCallouts": ["gm"]}, "expect": {"exclude_callouts": ["gm"]}, "legacy": [{"key": "excludeCallouts", "status": "used"}]},
  {"name": "landing: the vault file's object wins whole, the site file's keys are not merged in", "vault": {"landing": {"max_npcs": 2}}, "site": {"landing": {"max_locations": 9, "recency_window": 7}}, "expect": {"landing": {"recency_window": 3, "max_npcs": 2, "max_locations": 4, "featured_npcs": [], "featured_locations": [], "quick_links": []}}, "legacy": [{"key": "landing", "status": "ignored"}]}
