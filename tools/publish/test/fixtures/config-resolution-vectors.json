  {"name": "locations: per sub-key across the two files", "vault": {"locations": {"group_by": "kind"}}, "site": {"locations": {"x": 1}}, "expect": {"locations": {"group_by": "kind", "x": 1}}, "legacy": [{"key": "locations", "status": "ignored", "stillApplied": ["x"]}]}
