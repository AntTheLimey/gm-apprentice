  {"name": "exclude_callouts: an empty vault key is unset, so the site file's true applies", "vault": {"exclude_callouts": null}, "site": {"excludeCallouts": true}, "expect": {"exclude_callouts": true}, "legacy": [{"key": "excludeCallouts", "status": "used"}]},
  {"name": "exclude_callouts: the vault file's true is not weakened by the site file's list", "vault": {"exclude_callouts": true}, "site": {"excludeCallouts": ["gm"]}, "expect": {"exclude_callouts": true}, "legacy": [{"key": "excludeCallouts", "status": "ignored"}]},
  {"name": "exclude_callouts: a site list beats the vault file's false", "vault": {"exclude_callouts": false}, "site": {"excludeCallouts": ["gm"]}, "expect": {"exclude_callouts": ["gm"]}, "legacy": [{"key": "excludeCallouts", "status": "ignored", "stillApplied": ["gm"]}]},
  {"name": "exclude_callouts: two lists are unioned, the vault file's first", "vault": {"exclude_callouts": ["gm"]}, "site": {"excludeCallouts": ["GM", "secret"]}, "expect": {"exclude_callouts": ["gm", "secret"]}, "legacy": [{"key": "excludeCallouts", "status": "ignored", "stillApplied": ["secret"]}]},
  {"name": "exclude_callouts: a site list the vault list covers adds nothing", "vault": {"exclude_callouts": ["gm", "secret"]}, "site": {"excludeCallouts": ["gm"]}, "expect": {"exclude_callouts": ["gm", "secret"]}, "legacy": [{"key": "excludeCallouts", "status": "ignored"}]},
  {"name": "exclude_callouts: a site false does not weaken the vault file's list", "vault": {"exclude_callouts": ["gm"]}, "site": {"excludeCallouts": false}, "expect": {"exclude_callouts": ["gm"]}, "legacy": [{"key": "excludeCallouts", "status": "ignored"}]},
  {"name": "exclude_callouts as a list of types from the site file alone", "vault": {}, "site": {"excludeCallouts": ["gm"]}, "expect": {"exclude_callouts": ["gm"]}, "legacy": [{"key": "excludeCallouts", "status": "used"}]},
