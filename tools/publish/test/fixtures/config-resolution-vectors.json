  {"name": "landing: a vault map that covers the site map's sub-keys adds nothing", "vault": {"landing": {"max_npcs": 2, "max_locations": 1}}, "site": {"landing": {"max_locations": 9}}, "expect": {"landing": {"recency_window": 3, "max_npcs": 2, "max_locations": 1, "featured_npcs": [], "featured_locations": [], "quick_links": []}}, "legacy": [{"key": "landing", "status": "ignored"}]},
  {"name": "images: an empty vault key lets the site map apply", "vault": {"images": null}, "site": {"images": {"optimize": true}}, "expect": {"images": {"optimize": true, "format": "webp", "max_width": 1600, "quality": 82}}, "legacy": [{"key": "images", "status": "ignored", "stillApplied": ["optimize"]}]},
